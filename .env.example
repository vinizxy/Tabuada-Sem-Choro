# Copie para .env.local (local) e cadastre as mesmas na Vercel (Settings > Environment Variables).

# Link do checkout (Hotmart). Todos os botões de compra usam este link.
NEXT_PUBLIC_CHECKOUT_URL=https://pay.hotmart.com/M108071518O?checkoutMode=10

# ID do Pixel da Meta (só números). Vazio = pixel desligado.
NEXT_PUBLIC_META_PIXEL_ID=1096856816548017

# Endereço final do site, sem barra no fim. Usado em canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=https://tabuada-sem-choro-one.vercel.app

